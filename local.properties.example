# Copy to local.properties and fill in. That file is gitignored and must never be committed.
# Every key can also be supplied as an environment variable of the same name, which is what CI
# should do.

# Android SDK location. Android Studio writes this line for you.
sdk.dir=/path/to/Android/sdk

# OAuth 2.0 *Web* client ID from Google Cloud console. Not the Android client ID.
# Must be byte-identical to the CLIENT_ID in the Apps Script, which verifies the token's
# `aud` claim against it — a mismatch returns wrong_audience.
TESTTRACK_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Deployed Apps Script web app that answers the membership check.
TESTTRACK_GATE_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Public URL of the testers Google Group, used for the "open the group" shortcut.
TESTTRACK_GROUP_URL=https://groups.google.com/g/your-group

# Release signing. Optional — omit and only debug builds are produced.
# Google sign-in is bound to the signing certificate, so register this keystore's SHA-1 in the
# Cloud console or release builds will fail to sign in.
#TESTTRACK_KEYSTORE=/path/to/release.jks
#TESTTRACK_KEYSTORE_PASSWORD=
#TESTTRACK_KEY_ALIAS=
#TESTTRACK_KEY_PASSWORD=
