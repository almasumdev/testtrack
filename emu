#!/usr/bin/env sh
# Starts the emulator and waits until it is actually usable.
#
# Cold by default. A quick-boot snapshot restores the phone as it was, which is how an install can
# live in the snapshot while being absent from disk, and then vanish the next time it boots cold.
# Pass "warm" to use the snapshot, or an AVD name to pick a different device.
set -e

SDK="${LOCALAPPDATA:-$HOME/AppData/Local}/Android/Sdk"
ADB="$SDK/platform-tools/adb.exe"
AVD="Pixel_10"
BOOTMODE="-no-snapshot-load"

case "$1" in
  "")     ;;
  warm)   BOOTMODE="" ;;
  *)      AVD="$1" ;;
esac

if "$ADB" devices | grep -q '^emulator-'; then
  echo "Emulator already running: $("$ADB" devices | awk '/^emulator-/ {print $1; exit}')"
else
  echo "Starting $AVD ..."
  "$SDK/emulator/emulator.exe" -avd "$AVD" $BOOTMODE -netdelay none -netspeed full >/dev/null 2>&1 &
fi

"$ADB" wait-for-device
echo "Waiting for boot ..."
until [ "$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
  sleep 3
done
echo "Ready."
"$ADB" devices
