#!/usr/bin/env sh
# The same thing run.cmd does, for a POSIX shell. See that file for why each rule is here:
# the emulator and never the phone, install -r and never uninstall, debug and never release.
set -e

SDK="${LOCALAPPDATA:-$HOME/AppData/Local}/Android/Sdk"
ADB="$SDK/platform-tools/adb.exe"
HERE="$(cd "$(dirname "$0")" && pwd)"
PKG="com.eazyverse.testtrack"
: "${JAVA_HOME:=C:/Program Files/Android/Android Studio/jbr}"
export JAVA_HOME

SERIAL="$("$ADB" devices | awk '/^emulator-/ {print $1; exit}')"

if [ -z "$SERIAL" ]; then
  echo "No emulator is running. Start one with:  ./emu"
  echo
  echo "Refusing to fall back to an attached phone on purpose: this app writes to a live database"
  echo "and signs in as a real tester, and neither belongs on a handset by accident."
  exit 1
fi

echo "Building the debug apk ..."
"$HERE/gradlew.bat" :app:assembleDebug

echo "Installing on $SERIAL ..."
"$ADB" -s "$SERIAL" install -r "$HERE/app/build/outputs/apk/debug/app-debug.apk"

"$ADB" -s "$SERIAL" shell am force-stop "$PKG"
"$ADB" -s "$SERIAL" shell am start -n "$PKG/.MainActivity" >/dev/null
echo "Running."
