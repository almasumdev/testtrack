<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Proof that a tester installed an owner's app, and the ability to open it from the list.
      Still gives installed yes/no, the installing package, and firstInstallTime — the
      continuous-install streak, retroactively.

      Narrow by necessity rather than taste. QUERY_ALL_PACKAGES would read every package, but it
      is restricted on Play and TestTrack is not a launcher, antivirus, file manager or browser,
      which is close to the whole approved list. Staying off Play to keep it is not the neutral
      choice it sounds like: since Android 15, Enhanced Confirmation Mode greys out usage access
      for anything a browser installed, and usage access is what the proof is made of.

      Every app in a cohort is a consumer app in closed testing, so every one has a launcher
      entry and this query reaches all of them. One that does not is invisible here and reads as
      not installed — but it was never testable anyway, because getLaunchIntentForPackage returns
      null for it and a round cannot open what it cannot launch. Those are rejected at placement
      rather than left to hold a slot.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      Foreground time per app per day, which is what the daily report is actually made of.

      Not granted at install and not promptable: it is an appop the tester switches on under
      Settings -> Special access. Declaring it only puts TestTrack in that list. There is no
      cheaper source — timing the session from inside TestTrack measures only the visit TestTrack
      started, which is the number a tester could pass by waiting.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- MediaProjection only runs from a foreground service of this type since Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Returning to TestTrack after capturing someone else's app is a background activity launch,
      which Android refuses outright (BAL_BLOCK). Holding this is the documented exemption.
      Optional: without it capture still works and the tester switches back by hand.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The Uninstall button beside an app that has been taken out of testing.

      Granted at install and never prompted for, because it does not grant the power to remove
      anything: it only buys the right to ask. The system still puts up its own confirmation and
      the tester still has to agree to it, which is the whole point of sending them there rather
      than doing it quietly.

      Without it the request is not refused out loud. The system uninstaller starts, sees a caller
      that never declared this, and finishes before it draws, so the button looks broken rather
      than blocked.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Backup off on purpose. Everything the app keeps locally is either a cache of Firestore or a
      flag about a grant, and Android restores SharedPreferences onto a fresh install while the
      Firebase session and the usage-access appop do not come back with them. A restored "signed
      in, set up" state over no session sends the app straight past sign-in into a string of
      PERMISSION_DENIEDs. Nothing here is worth carrying across devices: sign in and it all
      returns from the account.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestTrack">

        <!--
          Off in debug, on in release, set from the build type. See app/build.gradle.kts: a debug
          build is force stopped and crashed on purpose all day, and its reports would drown the
          ones that came from a tester.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlytics}" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${analytics}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TestTrack"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Push. Exported because Play services delivers to it from outside the app; the
          MESSAGING_EVENT action is the documented contract and is not something another app can
          usefully call.
        -->
        <service
            android:name=".data.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Fallbacks for a message that arrives with a `notification` block, which the system posts
          without ever calling PushService. TestTrack sends data-only so that path is not used, but
          without these the system would fall back to the launcher icon — an iris square, drawn as
          a solid white block once Android masks it to alpha.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminders" />
    </application>

</manifest>
