<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Proof that a tester installed an owner's app, and the ability to open it from the list.
      Still gives installed yes/no, the installing package, and firstInstallTime — the
      continuous-install streak, retroactively.

      Narrow by necessity rather than taste. QUERY_ALL_PACKAGES would read every package, but it
      is restricted on Play and TestTrack is not a launcher, antivirus, file manager or browser,
      which is close to the whole approved list. Staying off Play to keep it is not the neutral
      choice it sounds like: since Android 15, Enhanced Confirmation Mode greys out usage access
      for anything a browser installed, and usage access is what the proof is made of.

      Every app in a crew is a consumer app in closed testing, so every one has a launcher entry
      and this query reaches all of them. One that does not reads as not installed, and could not
      be opened from tonight's list anyway, since getLaunchIntentForPackage returns null for it.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Whether any app can write an email, so Send feedback is shown only where it can work
             and the mail chooser never opens onto "No apps can perform this action". -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <!--
      Foreground time per app per day, which is what the daily report is actually made of.

      Not granted at install and not promptable: it is an appop the tester switches on under
      Settings -> Special access. Declaring it only puts TestTrack in that list. There is no
      cheaper source — timing the session from inside TestTrack measures only the visit TestTrack
      started, which is the number a tester could pass by waiting.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The review screenshot: MediaProjection only runs from a foreground service of this type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />



    <!--
      The review's floating camera button, drawn over Play while the reviewer takes the one
      screenshot that proves their review. See data/ReviewCaptureService.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <!--
      Backup off on purpose. Everything the app keeps locally is either a cache of what the server
      holds or a flag about a grant, and Android restores SharedPreferences onto a fresh install
      while the session and the usage-access appop do not come back with them. A restored "signed
      in" state over no session sends the app past sign-in into a string of refusals. Nothing here
      is worth carrying across devices: sign in and it all returns from the account.
    -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestTrack">

        <!--
          Off in debug, on in release, set from the build type. See app/build.gradle.kts: a debug
          build is force stopped and crashed on purpose all day, and its reports would drown the
          ones that came from a tester.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlytics}" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${analytics}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TestTrack.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- The review's one screenshot: a floating camera button over Play, one frame on press. -->
        <service
            android:name=".data.ReviewCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Push. Exported because Play services delivers to it from outside the app; the
          MESSAGING_EVENT action is the documented contract and is not something another app can
          usefully call.
        -->
        <service
            android:name=".data.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Fallbacks for a message that arrives with a `notification` block, which the system posts
          without ever calling PushService. TestTrack sends data-only so that path is not used, but
          without these the system would fall back to the full launcher artwork, drawn as
          a solid white block once Android masks it to alpha.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_robot" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminders" />
    </application>

</manifest>
