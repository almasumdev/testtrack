rules_version = '2';

// TestTrack access rules.
//
// The membership check that gates the UI runs in Apps Script and never reaches the database, so
// these rules cannot lean on it. What they can lean on is `groups/{id}.memberUids`, which only an
// admin can write — so "is this reader in that cohort?" is a question the database can answer for
// itself, and answer unforgeably.
//
// Everything a tester can see is scoped to a cohort they belong to. Anything that decides who
// tests what is admin-only.
//
// **Rules are not filters.** For a query, Firestore does not evaluate `resource.data` document by
// document; it demands the query constrain whatever fields the rule tests, so the entire result
// set is provably allowed before a single document is read. Every read condition below therefore
// has a matching `where` clause in Repo.kt, and adding one here without adding the other turns a
// working screen into a bare PERMISSION_DENIED with nothing wrong in the data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membership of this collection is the whole admin mechanism. An empty document is enough;
    // it exists so the admin app can be a separate build with no special client code here.
    // get()/exists() inside rules bypass read rules, so nothing needs to read this directly.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Is the caller in this cohort? Reads memberUids, which is admin-written, so a client cannot
    // talk its way in. Identical get() paths are cached within one request, so a query returning
    // a hundred proofs from one group costs a single document read here.
    function inGroup(groupId) {
      return signedIn()
        && groupId is string
        && groupId != ''
        && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // ---- enforcement -------------------------------------------------------------------
    //
    // A member who stops opening the other apps loses their place, and the phones in the cohort
    // are what carry that out — there is no server and the admin console is not in the loop. So
    // these rules do not take the client's word for any of it. Everything below re-derives the
    // verdict from the proof documents themselves, which means the worst a patched app can do is
    // be refused.
    //
    // Kept in step with Compliance.kt in the tester app by hand. The two compute the same sums and
    // both have to agree, or evictions start coming back PERMISSION_DENIED for no visible reason.

    /**
     * The event types a tester's device may write, rather than an admin.
     *
     * Named so the rules below cannot be widened by accident: every other kind of event stays
     * admin-only, and a client that wants to record anything else is refused on this string alone.
     */
    function TYPE_OWNER_BROADCAST() { return 'owner_broadcast'; }

    /** The other one: a tester telling an app's owner that feedback is waiting for them. */
    function TYPE_FEEDBACK() { return 'feedback'; }

    /** The third: an owner asking their cohort for feedback, the reverse of [TYPE_FEEDBACK]. */
    function TYPE_FEEDBACK_ASK() { return 'feedback_ask'; }

    /** How long an owner must wait between broadcasts to the same cohort. Matches Repo.kt. */
    function BROADCAST_COOLDOWN_MS() { return 172800000; }

    /** Same duration, own field — matches FEEDBACK_ASK_COOLDOWN_MS in Repo.kt. */
    function FEEDBACK_ASK_COOLDOWN_MS() { return 172800000; }

    /** Zero for a document written before broadcasting existed, which reads as never sent. */
    function lastBroadcastAtOf(appId) {
      return 'lastBroadcastAt' in appData(appId) ? appData(appId).lastBroadcastAt : 0;
    }

    /** Zero for a document written before asking for feedback existed, which reads as never asked. */
    function lastFeedbackAskAtOf(appId) {
      return 'lastFeedbackAskAt' in appData(appId) ? appData(appId).lastFeedbackAskAt : 0;
    }

    /** Whole days since the run began. Matches TestGroup.dayIndex(). */
    function dayOf(startDate) {
      return (request.time.toMillis() - startDate) / 86400000;
    }

    function appData(appId) {
      return get(/databases/$(database)/documents/apps/$(appId)).data;
    }

    /** [RUN_DAYS] unless an admin has extended this cohort. */
    function runDaysOf(group) {
      return 'runDays' in group ? group.runDays : 14;
    }

    /** Absent on every group written before opening days could be excused, which means none were. */
    function graceOf(group) {
      return 'graceDays' in group ? group.graceDays : 0;
    }

    /** Zero for a document written before placement dates were recorded, which blocks eviction. */
    function placedAtOf(appId) {
      return 'placedAt' in appData(appId) ? appData(appId).placedAt : 0;
    }

    /** Zero unless an admin has put this app back into testing, which blocks a flag until then. */
    function reinstatedAtOf(appId) {
      return 'reinstatedAt' in appData(appId) ? appData(appId).reinstatedAt : 0;
    }

    /**
     * The first day a member can be held to: the day after whichever of them arrived last.
     *
     * An app placed on day nine has no proofs for days one to eight, and reading those as misses
     * would evict its owner the moment anybody swept. Founding members predate the clock and are
     * held to all of it.
     */
    function firstJudged(placedAt, startDate) {
      return (placedAt <= 0 || startDate <= 0 || placedAt <= startDate)
        ? 0
        : ((placedAt - startDate) / 86400000) + 1;
    }

    /**
     * Proof ids are {appId}__{testerUid}__{runStartedAt}__{day}, so absence is a question this can
     * just ask.
     *
     * The run is part of the id because a restarted cohort numbers its days from zero again. Were
     * it not, the abandoned run's proofs would answer for the new one and nobody could ever be
     * removed from a restarted group.
     */
    function noProof(appId, uid, runStartedAt, day) {
      return !exists(
        /databases/$(database)/documents/proofs/$(
          appId + '__' + uid + '__' + string(runStartedAt) + '__' + string(day)
        )
      );
    }

    /** True once a cohort member has reported this app, before any admin has cleared it. */
    function isReported(appId) {
      return 'reportedAt' in appData(appId) && appData(appId).reportedAt > 0;
    }

    /**
     * True once [targetUid] has personally opted out of testing [appId] — see the `skips`
     * collection, admitted only while [appId]'s own `skippable` is set.
     */
    function skippedBy(appId, targetUid) {
      return exists(/databases/$(database)/documents/skips/$(appId + '__' + targetUid));
    }

    /** False for every app written before skipping existed, which is all of them until now. */
    function isSkippable(appId) {
      return 'skippable' in appData(appId) && appData(appId).skippable == true;
    }

    /**
     * Did this member genuinely miss the last two completed days on this app?
     *
     * Today is never counted: hours remain to open the app, so a gap in it is not a miss. Which
     * puts the earliest possible flag on day three, the first day with two finished days behind
     * it.
     */
    function missedTwo(byAppId, targetAppId, targetUid, targetPlacedAt, startDate, runDays, graceDays) {
      return startDate > 0
        && targetPlacedAt > 0
        && placedAtOf(byAppId) > 0
        // A reported app judges nobody until the report is cleared — see Enforcement.enforceOn,
        // which stops for the same reason on the client before ever reaching for this rule.
        && !isReported(byAppId)
        // Nor does one this member chose to skip themselves — their own call, not a fact about
        // the app, so it excuses only them and nobody else in the cohort.
        && !skippedBy(byAppId, targetUid)
        && dayOf(startDate) >= 2
        // Opening days an admin excused for the whole cohort. The same floor the tester app
        // applies, and it has to be here too or a device that agrees with the rule about
        // everything else has its write refused for agreeing about this.
        && dayOf(startDate) - 2 >= graceDays
        // Past the end of the run nothing is owed, so nothing can be missed. An admin may have
        // extended it, which is why this asks the group rather than assuming fourteen.
        && dayOf(startDate) < runDays
        && dayOf(startDate) - 2 >= firstJudged(placedAtOf(byAppId), startDate)
        && dayOf(startDate) - 2 >= firstJudged(targetPlacedAt, startDate)
        // The fourth floor: a member an admin only just put back into testing cannot be judged
        // on the very two days that got them flagged the first time — see Compliance.judgedDays'
        // own reinstatedAt floor, which this has to agree with or a device that trusts the client
        // math ends up flagging someone the rules themselves would refuse to flag again.
        && dayOf(startDate) - 2 >= firstJudged(reinstatedAtOf(targetAppId), startDate)
        && noProof(byAppId, targetUid, startDate, dayOf(startDate) - 1)
        && noProof(byAppId, targetUid, startDate, dayOf(startDate) - 2);
    }

    /**
     * Is this account barred from submitting?
     *
     * Read from the user's own document, which only an admin can set — see the `users` block, where
     * the owner is held to a fixed list of fields precisely so that nobody can lift their own ban.
     *
     * Blocking stops new submissions and nothing else. It deliberately does not eject anyone from a
     * run already under way: twelve other developers are depending on that cohort staying at
     * strength, and punishing them for one member's record is the wrong trade. Taking someone out
     * of a live group stays a separate, deliberate act.
     */
    function isBlocked(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && 'blocked' in get(/databases/$(database)/documents/users/$(uid)).data
        && get(/databases/$(database)/documents/users/$(uid)).data.blocked == true;
    }

    /**
     * An avatar that will not slow down somebody else's group screen.
     *
     * Eight thousand base64 characters, against an app that squeezes to six and gives up rather
     * than exceed it. The headroom is for a future that stores a slightly larger face, not for a
     * client to fill: the cost of this field is paid thirty times over on every cohort read, which
     * is a much tighter constraint than the megabyte a document is allowed.
     *
     * A missing field passes. Most accounts never set one, and every write that only touches the
     * name goes through here too.
     */
    function smallEnoughPhoto() {
      return !('photo' in request.resource.data)
        || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 8000);
    }

    /**
     * The admin list.
     *
     * Writes are console-only — an admin app that could grant admin would make the whole thing
     * decorative. Reads are limited to your own row, and that narrow opening is what lets the
     * admin app tell "you are not an administrator" apart from "something went wrong": without it
     * the only way to find out is to attempt a privileged write and read the refusal, and every
     * screen opens on a bare PERMISSION_DENIED naming nothing.
     *
     * Your own row leaks nothing. The list cannot be enumerated, and nobody can ask about anybody
     * else — `get()`/`exists()` inside a rule bypass this block entirely, so [isAdmin] is
     * unaffected either way.
     */
    /**
     * The update policy every install reads on the way in.
     *
     * One document, four numbers, and it decides whether somebody can use the app at all — so it
     * is written from the console and from nowhere else. A client that could raise
     * `minSupportedBuild` could lock out a whole cohort, and one that could lower it could keep
     * itself on a build the cohort has moved past.
     *
     * `get` rather than `read`: there is one document here and nothing to list. Signed in, because
     * an install that has not got that far has nothing to be gated out of yet, and a missing
     * document already resolves to "block nobody".
     */
    match /config/{doc} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    /**
     * Names shown in grids.
     *
     * Open to any signed-in account, deliberately and knowingly: a grid needs to turn a uid into
     * a name, and the queries that do it are `whereIn` over uid lists that rules cannot correlate
     * back to a cohort without a reverse index the admin would then have to maintain. What is
     * exposed is an address and a display name — not proof, not group structure. If that stops
     * being an acceptable trade, the fix is an admin-written `groupIds` array here.
     */
    match /users/{uid} {
      allow read: if signedIn();

      /**
       * An account writes its own row, but only the fields that are its own business.
       *
       * `blocked` lives on this document and is an admin's judgement, so an owner allowed to write
       * the document freely could simply clear it — a ban anybody can lift is not a ban. Held to a
       * fixed list rather than a denylist, so a field added later is closed by default instead of
       * open until somebody remembers.
       *
       * `photo` is a base64 avatar, and the size limit is not a formality. This document is read
       * thirty at a time whenever a cohort turns uids into names, so an unbounded picture here is
       * a slow group screen for twelve other people rather than a large document for its owner.
       * The app aims well under this; the number is what a client that skips the app is held to.
       */
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys()
             .hasOnly(['uid', 'email', 'displayName', 'photo', 'updatedAt'])
        && smallEnoughPhoto()
      );

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uid', 'email', 'displayName', 'photo', 'updatedAt'])
        && smallEnoughPhoto()
      );

      allow delete: if isAdmin();
    }

    /**
     * Push addresses for one account's devices, one document per install.
     *
     * A separate block and not an oversight: rules do **not** cascade to subcollections unless the
     * parent match uses `{document=**}`, so `users/{uid}` above governs the user document alone.
     * That is exactly what is wanted here — the user document is readable by every signed-in
     * account so grids can turn a uid into a name, and device tokens must not inherit that. A
     * token is an address anyone could send to once a sender key leaks, and there is no reason for
     * one tester to hold another's.
     *
     * Written by the device it belongs to, read by whatever ends up doing the sending — which is
     * an admin credential today and the admin app later.
     */
    match /users/{uid}/tokens/{installId} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    /**
     * Which handset an account signs in from, as a salted hash.
     *
     * Play counts testers rather than accounts, and two accounts on one phone are one tester to
     * it. A cohort carrying that unknowingly wastes a fortnight for thirteen other people, so an
     * admin needs to be able to see it. Nothing here enforces anything: a duplicate is two rows
     * holding the same string, and what happens next is a person's decision.
     *
     * Its own collection rather than a field on the user document, which is the entire reason this
     * block exists. `users/{uid}` is readable by every signed-in account so a grid can turn a uid
     * into a name; a fingerprint sitting there would let any tester work out which of their cohort
     * share a phone, which is nobody's business but the admin's.
     *
     * So: `get` for the owner and for admins, `list` for admins alone. Without that split the
     * owner's own read permission would let anybody enumerate the collection and do the matching
     * themselves, which is the leak this block was written to close.
     *
     * Writes are the owner's, held to the three fields and pinned to their own uid, so nobody can
     * plant a fingerprint on somebody else's row and manufacture a duplicate. Only an admin
     * deletes, which is what clears a claim left behind by a phone that changed hands.
     */
    match /devices/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create, update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'deviceId', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.deviceId is string
      );

      allow delete: if isAdmin();
    }

    // A swap cohort: fourteen members, one app each, one shared 14-day run.
    //
    // Readable only by its own members, so the shape of other people's cohorts is not browsable.
    // Entirely admin-written: members are added by placing their app and the run starts when the
    // thirteenth arrives, and no client can do either — otherwise a tester could start their own
    // clock or write themselves into someone else's cohort.
    match /groups/{groupId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.memberUids);

      // Entirely admin-written. A member who stops opening the other apps in their cohort is
      // flagged on the app document below, for an admin to act on — nothing here removes anyone
      // from a group without an admin's own hand on it. See apps/{appId}'s flag rule and
      // Enforcement.enforceOn for why that changed.
      allow write: if isAdmin();
    }

    /**
     * An app someone has registered.
     *
     * Visible to its owner and to the cohort testing it — nothing else. A pending app carries no
     * group, so until an admin places it only its owner can see it.
     *
     * Placement is not the owner's to set: approving an app *is* assigning it to a group, and that
     * is an admin's judgement. Pinning both fields on write is what stops approval being
     * self-granted.
     */
    match /apps/{appId} {
      /**
       * A package nobody has registered has to read as absent rather than as refused.
       *
       * `resource` is null for a document that does not exist, and the two conditions below
       * dereference it. A rule that errors is a rule that denies, so without this branch every
       * first-ever submission came back PERMISSION_DENIED, which submitApp reads as proof the
       * package belongs to somebody else and reports as "already registered by another member".
       *
       * All this admits is whether a package name is taken, which is exactly the question the
       * submit screen is asking on the owner's behalf. Nothing about a document that does exist
       * is loosened: those are still owner-only or cohort-only, so a name held by a stranger is
       * still refused and still reported as taken.
       */
      allow read: if isAdmin()
        || (signedIn() && resource == null)
        || (signedIn() && request.auth.uid == resource.data.ownerUid)
        || inGroup(resource.data.groupId);

      // A blocked account cannot register anything. Refused here rather than hidden in the app,
      // so the ban holds against a client that simply skips the check.
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.status == 'pending'
        && request.resource.data.groupId == ''
        && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500)
        && !isBlocked(request.auth.uid)
      );

      /**
       * `removed` is the whole of a soft removal, so it is admin-only or it is nothing.
       *
       * The three fields are refused by name rather than by value, because an owner writing
       * `removed: false` over their own removal is the entire attack and it looks like an
       * ordinary update from every other angle. Absent fields are handled by asking what the
       * write *touches*: documents from before this existed have none of them, and a write that
       * leaves them alone affects no key here whether they are there or not.
       *
       * `packageName` is pinned. It is what a tester's phone installs and opens, and until now an
       * owner already placed in a running cohort could point it anywhere: the document id stays
       * the package that was claimed, so nothing about the claim looks wrong and twelve people
       * quietly spend their fortnight opening a different app.
       *
       * `name` is deliberately not pinned beside it. Resubmitting is how a typo gets fixed, the
       * write merges into a placed document on purpose, and a developer correcting their own app's
       * name on day nine is the feature rather than the attack.
       *
       * `notes` is capped here as well as in the app. The tester app stops at NOTES_MAX and the
       * console only ever reads the field, so nothing legitimate comes near this limit — but the
       * string is rendered in a list row by all twelve members of the cohort, and a client that
       * skips the check is exactly the one that would put a megabyte in it.
       *
       * `reported*` is pinned alongside `removed*` for the same reason: an owner clearing a report
       * filed about their own app is the same attack in a different field, and this rule is wide
       * enough otherwise (nothing else here names those keys) that it would otherwise admit it.
       *
       * `lastBroadcastAt` and `lastFeedbackAskAt` are pinned too, and admitted only through their
       * own dedicated rules below — this one has no cooldown check, so leaving either open here
       * would let an owner bump their own timestamp for free without the wait it exists to
       * enforce.
       *
       * `skippable` is pinned for the same reason as `removed`/`reportedAt`: it is the switch that
       * lets the whole cohort start skipping this app member by member, and an owner granting
       * their own app that blanket immunity is exactly the attack pinning exists to close. Set
       * only by an admin, through the unrestricted branch above.
       *
       * `flagged*`/`reinstatedAt` are pinned the same way again: an owner clearing their own flag,
       * or backdating their own reinstatement to widen the days it excuses, is the identical
       * attack in fields that did not exist when the others were closed.
       */
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.packageName == resource.data.packageName
        && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['removed', 'removedAt', 'removedReason',
                      'reportedAt', 'reportedBy', 'reportedReason',
                      'lastBroadcastAt', 'lastFeedbackAskAt', 'skippable',
                      'flaggedAt', 'flaggedByAppId', 'reinstatedAt'].toSet())
      );

      /**
       * The app-side half of an owner's broadcast: moving `lastBroadcastAt` forward.
       *
       * Own app only, one field only, and gated by the same cooldown the events half checks — see
       * the `owner_broadcast` rule above for why both sides ask the same question rather than one
       * trusting the other already did.
       */
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastBroadcastAt'].toSet())
        && request.resource.data.lastBroadcastAt is int
        && request.resource.data.lastBroadcastAt > 0
        && request.time.toMillis()
             - (('lastBroadcastAt' in resource.data) ? resource.data.lastBroadcastAt : 0)
             >= BROADCAST_COOLDOWN_MS();

      /**
       * The app-side half of an owner's feedback ask: moving `lastFeedbackAskAt` forward.
       *
       * Same shape as the broadcast's own app-side rule directly above — own app only, one field
       * only, gated by the same cooldown the events half checks.
       */
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFeedbackAskAt'].toSet())
        && request.resource.data.lastFeedbackAskAt is int
        && request.resource.data.lastFeedbackAskAt > 0
        && request.time.toMillis()
             - (('lastFeedbackAskAt' in resource.data) ? resource.data.lastFeedbackAskAt : 0)
             >= FEEDBACK_ASK_COOLDOWN_MS();

      /**
       * Withdrawing: the owner taking their own app out, without destroying the record.
       *
       * A delete until now, and the delete is what this replaces. Losing the document lost the
       * only proof the app had ever been submitted, released a package name that should stay
       * claimed, and left an admin nothing to reverse.
       *
       * Narrow on purpose, because `status` is otherwise pinned for owners and this is the single
       * exception. Only from `pending`: an app inside a cohort is twelve other people's obligation
       * for the fortnight, and walking away from that is an admin's call rather than a button.
       * Only to `withdrawn`, so this cannot become a way of reviving anything — an owner still
       * cannot move their own app back to `pending`, which is the whole point of the claim.
       *
       * `withdrawnAt` is admitted alongside it, and nothing else is.
       */
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'withdrawn'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'withdrawnAt'].toSet());

      /**
       * A member who stopped opening this app flags its owner, for an admin to see.
       *
       * Nothing here touches the group or even this document's own testability — `hasOnly` says
       * exactly the two fields this may change and refuses the rest by construction, so a field
       * added to app documents next year cannot quietly become writable by a peer. Taking
       * somebody out of testing, or dropping them from the group, is `removed`/`groups` and
       * admin-only either way; see Enforcement.enforceOn for why a device no longer does either
       * one itself.
       *
       * Set-once, the same shape as the report rule below: `resource.data.flaggedAt` must be
       * unset or zero going in, so a dozen devices reaching the same verdict about the same two
       * days cost one write and eleven refusals, not twelve pushes to the same admin.
       *
       * And never yourself. Flagging your own app cannot help you, but it would tell an admin
       * something false about who noticed.
       *
       * And never an app already taken out of testing. `removed` excuses it from judgment
       * entirely — see Enforcement.enforceOn's matching client-side skip — so without this a
       * removed app would keep getting re-flagged on every sweep, forever, since it can never
       * earn back the attendance that would otherwise clear the flag.
       */
      allow update: if signedIn()
        && resource.data.groupId is string
        && resource.data.groupId != ''
        && inGroup(resource.data.groupId)
        && resource.data.ownerUid != request.auth.uid
        && (!('removed' in resource.data) || resource.data.removed != true)
        && (!('flaggedAt' in resource.data) || resource.data.flaggedAt == 0)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['flaggedAt', 'flaggedByAppId'].toSet())
        && request.resource.data.flaggedAt is int
        && request.resource.data.flaggedAt > 0
        && 'flaggedByAppId' in request.resource.data
        && appData(request.resource.data.flaggedByAppId).ownerUid == request.auth.uid
        && appData(request.resource.data.flaggedByAppId).groupId == resource.data.groupId
        && missedTwo(
             request.resource.data.flaggedByAppId,
             appId,
             resource.data.ownerUid,
             ('placedAt' in resource.data ? resource.data.placedAt : 0),
             get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.startDate,
             runDaysOf(
               get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data
             ),
             graceOf(
               get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data
             )
           );

      /**
       * A cohort member saying an app would not open, or broke, before any admin hears about it
       * another way — see reportProblem in Repo.kt.
       *
       * A report is a fact a device can attest to about itself, the same shape of claim the
       * self-service removal above makes, so it is written directly rather than waiting on
       * somebody reading a push. Nothing here judges whether the app really is broken; that is
       * for an admin to decide once they see it, from the console.
       *
       * Set-once. `resource.data.reportedAt` must be unset or zero going in, so a tester cannot
       * bump their own report's timestamp. Undoing one is a different write, admitted by the rule
       * just below rather than by widening this one — an owner still cannot touch either.
       *
       * Never the owner. There is nothing for an owner to report about their own app; admitting
       * them here would just be a second way to write `removed`-shaped relief without the
       * missedTwo check the removal rule requires.
       */
      allow update: if signedIn()
        && resource.data.groupId is string
        && resource.data.groupId != ''
        && inGroup(resource.data.groupId)
        && resource.data.ownerUid != request.auth.uid
        && (!('reportedAt' in resource.data) || resource.data.reportedAt == 0)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reportedAt', 'reportedBy', 'reportedReason'].toSet())
        && request.resource.data.reportedAt is int
        && request.resource.data.reportedAt > 0
        && request.resource.data.reportedBy == request.auth.uid
        && (!('reportedReason' in request.resource.data)
             || request.resource.data.reportedReason.size() <= 500);

      /**
       * The reporter taking their own report back — see clearMyReport in Repo.kt.
       *
       * Only `reportedBy` may do this, not the wider cohort and not the owner: it is the one
       * person who can attest the thing they reported got sorted out, or that they jumped the
       * gun. An admin can still clear any report through the unrestricted `allow update` above —
       * this rule only ever adds a second door for the reporter's own, never takes theirs away.
       *
       * Full zero, not a partial edit. Anything short of putting all three fields back to their
       * unset shape would leave `reportedBy` pointing at this tester while the report itself
       * reads as gone, which is a state nothing else here expects to see.
       */
      allow update: if signedIn()
        && resource.data.groupId is string
        && resource.data.groupId != ''
        && ('reportedBy' in resource.data)
        && resource.data.reportedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reportedAt', 'reportedBy', 'reportedReason'].toSet())
        && request.resource.data.reportedAt == 0
        && request.resource.data.reportedBy == ''
        && (!('reportedReason' in request.resource.data)
             || request.resource.data.reportedReason == '');

      /**
       * An admin, and nobody else.
       *
       * Closed to everyone for a long time, and the reasoning still holds for the owner: a
       * developer who could delete their own submission could release the package name's claim,
       * erase the reason it was refused, and come back as a stranger. Withdrawing and being
       * turned down both keep the document where the person who made it can still see it, which
       * is what those statuses are for.
       *
       * None of that is an argument for the console being unable to erase anything. A test
       * submission, a duplicate, a package that should never have been registered, an account
       * being wiped at its owner's request: every one of those is a document that has to go, and
       * until this opened the only answer was the Firebase web console. An admin acting through
       * the app they were given beats an admin reaching around it.
       *
       * Deliberate and unrecoverable, so the console asks for the package name to be typed before
       * it will. That guard is the app's and cannot be enforced here; what can be enforced is
       * that only an admin ever reaches this line.
       */
      allow delete: if isAdmin();
    }

    /**
     * One member's own choice to skip one app — see Repo.kt's setSkip/clearSkip and
     * DashboardScreen's TestRow toggle.
     *
     * A row per (app, member), not a field on `apps`: `removed` and `reportedAt` both excuse the
     * whole cohort at once, and this is the one place a member's decision is theirs alone rather
     * than something the app document could hold, since two members of the same cohort routinely
     * disagree about the same app.
     *
     * Doc id is `{appId}__{uid}`, exactly like a proof id without the run/day suffix — existence is
     * the whole fact, so create is "skip" and delete is "un-skip," and there is nothing to update.
     */
    match /skips/{skipId} {
      allow read: if isAdmin() || inGroup(resource.data.groupId);

      /**
       * Own uid only, own choice only, and only where an admin has actually opened this app up to
       * being skipped — `skippable` is the switch, checked fresh against the live document rather
       * than trusted from the write, so a client cannot skip an app the admin never allowed just by
       * omitting the check on its own side.
       *
       * The owner is excluded on the same reasoning as everywhere else here: skipping your own app
       * is not a real choice about testing it, it is a stray write nothing should have to account
       * for.
       */
      allow create: if signedIn()
        && skipId == request.resource.data.appId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && inGroup(request.resource.data.groupId)
        && appData(request.resource.data.appId).ownerUid != request.auth.uid
        && appData(request.resource.data.appId).groupId == request.resource.data.groupId
        && isSkippable(request.resource.data.appId);

      allow update: if false;

      /** Un-skipping. An admin may also clear one, the same way they clear a report. */
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /**
     * What an admin decided about someone.
     *
     * The admin console is a phone app, and a phone app cannot send push — FCM's v1 API wants a
     * service account, and a service account key inside an APK is one in everybody's hands. So a
     * decision is written here and the addressed device raises it locally. Which makes this the
     * audit trail as well: `actorUid` is the admin who acted.
     *
     * Addressed to exactly one person and readable by exactly that person, so the query in
     * AdminEvents constrains `uid` — rules are not filters, and a read without that clause is
     * refused however impeccable the documents are.
     *
     * Append-only from an admin. A tester cannot write themselves an approval, and nobody can
     * quietly erase a decision after the fact.
     */
    match /events/{eventId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.uid);

      allow create: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.actorUid == request.auth.uid;

      /**
       * An owner telling one member of their cohort an update is out — see Repo.kt's
       * broadcastUpdate, which writes one of these per member in the same batch that advances
       * the app's own `lastBroadcastAt`.
       *
       * The cooldown is checked here too, not only on the `apps` write below: this is the half
       * that actually lands in somebody else's mailbox, and reading `lastBroadcastAt` against the
       * pre-batch snapshot is what stops a client from writing the twelve events first and the
       * timestamp bump after, hoping the check would only ever see its own side of the batch.
       */
      allow create: if signedIn()
        && request.resource.data.type == TYPE_OWNER_BROADCAST()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.uid != request.auth.uid
        && inGroup(request.resource.data.groupId)
        && appData(request.resource.data.appId).ownerUid == request.auth.uid
        && appData(request.resource.data.appId).groupId == request.resource.data.groupId
        && request.resource.data.uid in
             get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
               .data.memberUids
        && request.time.toMillis() - lastBroadcastAtOf(request.resource.data.appId)
             >= BROADCAST_COOLDOWN_MS();

      /**
       * An owner asking one member of their cohort for feedback — see Repo.kt's
       * askForFeedback, which writes one of these per member in the same batch that advances
       * the app's own `lastFeedbackAskAt`. Same shape as the `owner_broadcast` rule above, for
       * the same reasons — including the same pre-batch cooldown read.
       */
      allow create: if signedIn()
        && request.resource.data.type == TYPE_FEEDBACK_ASK()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.uid != request.auth.uid
        && inGroup(request.resource.data.groupId)
        && appData(request.resource.data.appId).ownerUid == request.auth.uid
        && appData(request.resource.data.appId).groupId == request.resource.data.groupId
        && request.resource.data.uid in
             get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
               .data.memberUids
        && request.time.toMillis() - lastFeedbackAskAtOf(request.resource.data.appId)
             >= FEEDBACK_ASK_COOLDOWN_MS();

      /**
       * A tester telling an app's owner that feedback is waiting for them — see Repo.kt's
       * submitFeedback, which writes one of these in the same batch as the feedback document
       * itself. No cooldown: the feedback collection's own once-a-day-per-app shape is already
       * what keeps this from repeating, and this rule does not need to re-derive that.
       */
      allow create: if signedIn()
        && request.resource.data.type == TYPE_FEEDBACK()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.uid != request.auth.uid
        && inGroup(request.resource.data.groupId)
        && appData(request.resource.data.appId).ownerUid == request.resource.data.uid
        && appData(request.resource.data.appId).groupId == request.resource.data.groupId;

      /**
       * Never edited. Erased only as part of erasing what it is about.
       *
       * An event is the audit trail, so rewriting one after the fact is closed to everybody
       * including the admin who wrote it. Deleting is admitted for one reason: an app or an
       * account being erased outright leaves its notifications addressed to nothing, and a record
       * of decisions about something that no longer exists is not an audit trail, it is litter.
       */
      allow update: if false;
      allow delete: if isAdmin();
    }

    /**
     * A cohort's own record — who joined, who was taken out of testing and put back, who was
     * kicked, and when. See AdminRepo.logHistory.
     *
     * Its own collection rather than another `events` type: `events` is deliberately disposable —
     * an app or an account being erased takes its events with it, see that block's own delete
     * rule — and the entire point here is the opposite. Nothing in this collection is ever
     * deleted, not even by an admin.
     *
     * Unbounded by construction — nothing is ever removed from a group's record, which is the
     * whole point — so this cannot be read the way `apps` reads `inGroup(groupId)`: that check
     * costs a `get()` per matched document, and `proofs` below already documents what happens
     * once a query like that grows past a handful of results. So this stays off the `inGroup`
     * path entirely: an admin sees every row through `isAdmin()`, which costs nothing extra
     * regardless of how large this grows; everyone else sees only the rows actually about them,
     * which is also what lets somebody keep seeing their own the day after `inGroup` itself would
     * have started refusing them.
     */
    match /history/{entryId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.uid);

      /**
       * Admin-only: every trigger today is an admin action. `groupId` is required and non-blank,
       * unlike `events` where it is often absent — a line in a cohort's own record that does not
       * name the cohort is not a record of anything.
       */
      allow create: if isAdmin()
        && request.resource.data.groupId is string
        && request.resource.data.groupId != ''
        && request.resource.data.uid is string
        && request.resource.data.uid != ''
        && request.resource.data.type in ['joined', 'removed', 'restored', 'kicked']
        && request.resource.data.actorUid == request.auth.uid;

      // Never edited, never deleted — see the block's own note above.
      allow update, delete: if false;
    }

    /**
     * Proof of one tester's visit to one app on one day.
     *
     * The sensitive collection: each document points at a full-screen capture readable by anyone
     * holding its Drive link.
     *
     * Reading needs **no document lookup**, deliberately. Only two people ever read a proof — the
     * tester who posted it, and the owner of the app it is about — and both are named in the
     * document, so the rule is two equality checks. An earlier version fetched the group to test
     * cohort membership; that survives the fourteen-document apps query and is refused on the
     * forty-five-document proofs query, which is the whole grid.
     *
     * Integrity lives on the write instead, where a single-document request can afford the fetch:
     * the writer must be the tester, must be in the cohort, and cannot invent an owner.
     *
     * Document ids are {appId}__{testerUid}__{day}, so re-posting overwrites rather than
     * duplicating.
     */
    match /proofs/{proofId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.testerUid)
        || (signedIn() && request.auth.uid == resource.data.ownerUid);

      allow create, update: if isAdmin() || (
        signedIn()
        && request.auth.uid == request.resource.data.testerUid
        && inGroup(request.resource.data.groupId)
        && request.resource.data.ownerUid ==
             get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.ownerUid
      );

      /**
       * An admin, and only ever alongside the thing it is proof of.
       *
       * A tester cannot withdraw evidence they already posted, and an app owner cannot destroy a
       * day somebody covered — that is the whole reliability record, and a record anybody can
       * prune is not one. The console deletes these only when the app or the account they belong
       * to is being erased, where leaving them behind would keep counting days towards a
       * developer who is gone.
       *
       * The screenshot itself lives in Drive and is not reached from here. Deleting the document
       * removes the day from every grid and every count; the file stays where it was uploaded.
       */
      allow delete: if isAdmin();
    }

    /**
     * A tester's own note about an app — a rough edge, a typo, something worth the owner hearing
     * that isn't the app being broken outright. See Repo.submitFeedback and Feedback in Models.kt.
     *
     * Same shape as `proofs` on purpose, including why: a `feedbackId` query is one document, so
     * the integrity check happens on the write rather than being re-proven on every read.
     *
     * Document ids are {appId}__{testerUid}__{runStartedAt}__{day}, so a second note the same day
     * overwrites rather than piling up — the same reasoning `proofs` already gives.
     */
    match /feedback/{feedbackId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.testerUid)
        || (signedIn() && request.auth.uid == resource.data.ownerUid);

      allow create, update: if isAdmin() || (
        signedIn()
        && request.auth.uid == request.resource.data.testerUid
        && inGroup(request.resource.data.groupId)
        && request.resource.data.ownerUid == appData(request.resource.data.appId).ownerUid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
      );

      /**
       * An admin, same as `proofs`: not the tester who wrote it, and not the owner it's about —
       * the point of a note the owner cannot make disappear is lost the moment they can.
       */
      allow delete: if isAdmin();
    }
  }
}
