*.iml
.gradle/
# Written by Android Studio's updateDaemonJvm. It pins the daemon to a JDK the
# local machine happens to have; CI sets up its own, so committing it would only
# make the runner go and fetch a second one.
gradle/gradle-daemon-jvm.properties
.kotlin/
__pycache__/
/local.properties
/.idea/
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Secrets. Config values live in local.properties and reach the app through
# BuildConfig; see local.properties.example for the keys required.
secrets.properties
*.keystore
*.jks
google-services.json

# Rules tests pull their own toolchain; nothing in it belongs in the repo.
firestore-tests/node_modules/
firestore-debug.log
firebase-debug.log

# The Apps Script behind the membership check. Deliberately not tracked: the copy that decides
# anything is the one deployed at /exec, and a second copy in here is one more thing to drift.
gate.gs

# Local run helpers. They hardcode this machine's SDK path and AVD name, so they are one
# developer's convenience rather than a project decision.
/run.cmd
/emu.cmd
# The interactive log console run.cmd hands over to. Same category: it exists to make one
# machine's edit-and-look loop quick, and it is useless without the .cmd that calls it.
/run-console.ps1

# mkit: this app's secrets
.env

# Read-only snapshots of the existing Play listing.
/store/backups/

# Store art built by `mkit art build` (sources: store/art)
/store/screenshots/
/store/feature/

# Local tool notes, not part of the project.
.commandcode/
# Built locally from the gitignored store art.
/store/preview.html

# Store keyword research (mkit aso): the maintainer's working data.
/console/
todo.txt
# Videos: the Remotion project, its voices and renders. Large, and rebuilt from its own sources.
/media/
